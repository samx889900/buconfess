# ============================================================================
# BU Confessions v3.4 — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to version control.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                  # Admin / GitHub Actions ONLY (bypasses RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=              # Public app ONLY (respects RLS)

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Instagram Graph API ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
IG_CAPTION_PREFIX=BU Confession
IG_HANDLE=bu.confess

# --- Google Sheets (Admin Sync Only) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
DIGEST_EMAIL=

# --- Admin Authentication & Security ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                        # bcrypt hash (cost 10), NEVER plaintext
                                            # Generate with: npx bcryptjs hash "your-password"
JWT_SECRET=                                 # Strong random string for JWT signing
IP_HASH_SECRET=                             # Secret salt for HMAC-SHA256 IP hashing

# --- App Config ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- GitHub Actions Trigger (Fine-grained PAT) ---
# GITHUB_TOKEN=                             # Only needed if triggering from admin dashboard
# GITHUB_REPO=owner/repo                    # Only needed if triggering from admin dashboard
